<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" />
{{ 'section-rich-text.min.css' | asset_url | stylesheet_tag }}
<section class="single__banner-wrapper cgb__wrapper">
  <div class="swiper single__banner-slider">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'slide' %}
              <div class="swiper-slide">
                <div class="cgb__slide-inner">
                  <div class="single__banner-slide--image">
                    <a href="{{ block.settings.banner_image_url }}" aria-label="{{block.settings.single__slide-image.alt}}">
                      {%- liquid
                            assign sizes = '120vw'
                            assign widths = '280 , 350, 450, 550, 660, 900, 1320, 1920'
                      -%}
                      {% if block.settings.single__slide-image != blank  %}
                        {{
                          block.settings.single__slide-image
                          | image_url: width: 1920
                          | image_tag: loading: 'lazy', sizes: sizes, widths: widths
                        }}
                       {% else %}
                        {{ "image" | placeholder_svg_tag:"placeholder-svg-tag" }}
                       {% endif %}
                     </a>
                  </div>
                  <div class="banner__sm-screen">
                    <a href="{{ block.settings.banner_image_url }}"  aria-label="{{block.settings.single__slide-mobile--image.alt}}">
                      {%- liquid
                            assign sizes = '120vw'
                            assign widths = '280 , 350, 450, 550, 660, 900, 1320, 1920'
                      -%}
                      {% if block.settings.single__slide-mobile--image != blank  %}
                        {{
                          block.settings.single__slide-mobile--image
                          | image_url: width: 1920
                          | image_tag: loading: 'lazy', sizes: sizes, widths: widths
                        }}
                       {% else %}
                        {{ "image" | placeholder_svg_tag:"placeholder-svg-tag" }}
                       {% endif %}
                     </a>
                  </div>
                  <div class="cgb__slide-content" {% if block.settings.text_color %}style="color: {{ block.settings.text_color }};"{% endif %}>
                    {%- if block.settings.heading != blank or block.settings.subheading != blank -%}
                      <div class="title-bar custom-font">
                        {%- if block.settings.heading != blank -%}
                          <h2 class="cgb__slide-heading wow">{{ block.settings.heading }}</h2>
                        {%- endif -%}
                        {%- if block.settings.subheading != blank -%}
                          <p class="cgb__slide-subheading wow">{{ block.settings.subheading }}</p>
                        {%- endif -%}
                      </div>
                    {%- endif -%}
                    {%- if block.settings.button_label != blank -%}
                      <a
                        href="{{ block.settings.button_link | default: block.settings.banner_image_url | default: '#' }}"
                        class="cgb__slide-button btn"
                        style="background-color: #4E3120; color: #FFFFFF;"
                      >
                        {{ block.settings.button_label }}
                      </a>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {% endcase %}
        {% endfor %}
      </div>
    </div>
</section>
<script src="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.js"></script>
<script>
  var swiper = new Swiper(".single__banner-slider", {
    autoplay: {
      delay: 5000,
      disableOnInteraction: false,
    },
  });
</script>
{% schema %}
  {
    "presets": [
      {
        "name" : "Corporate Banner Slider"
      }
    ],
    "name": "Corporate Banner Slider",
    "settings": [],
    "max_blocks": 10,
    "blocks": [
       {
         "name": "Slide",
         "type": "slide",
         "settings": [
           {
             "type": "image_picker",
             "id": "single__slide-image",
             "label": "Image"
           },
           {
             "type": "image_picker",
             "id": "single__slide-mobile--image",
             "label": "Mobile Image"
           },
           {
              "type":"url",
              "id":"banner_image_url",
              "label":"Link"
           },
           {
              "type": "text",
              "id": "heading",
              "label": "Heading",
              "default": "Corporate Gifting"
           },
           {
              "type": "text",
              "id": "subheading",
              "label": "Subheading",
              "default": "Sub Text Here"
           },
           {
              "type": "color",
              "id": "text_color",
              "label": "Heading/subheading color"
           },
           {
              "type": "text",
              "id": "button_label",
              "label": "Button label",
              "default": "Learn More"
           },
           {
              "type": "url",
              "id": "button_link",
              "label": "Button link",
              "info": "Defaults to the slide's Link above if left blank"
           }
         ]
       }
    ]
  }
{% endschema %}

{% stylesheet %}
  #shopify-section-{{ section.id }} {
    margin: 0 !important;
    padding: 0 !important;
  }

  #shopify-section-{{ section.id }} .cgb__wrapper {
    margin-top: 0 !important;
    margin-bottom: 0 !important;
  }

  #shopify-section-{{ section.id }} .cgb__slide-inner {
    position: relative;
  }

  #shopify-section-{{ section.id }} .cgb__slide-content {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    z-index: 5;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 0.5rem;
    width: 90%;
    max-width: 44rem;
  }

  #shopify-section-{{ section.id }} .cgb__slide-heading {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cgb__slide-subheading {
    margin: 0;
    font-size: 1.1em;
    font-weight: 400 !important;
    font-family: var(--font-body-family, sans-serif) !important;
  }

  #shopify-section-{{ section.id }} .cgb__slide-button.btn {
    display: inline-block;
    margin-top: 0.5rem;
    padding: 0.65rem 1.75rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 0;
    white-space: nowrap;
    background-color: #4E3120 !important;
    color: #FFFFFF !important;
  }

  #shopify-section-{{ section.id }} .cgb__slide-button:hover {
    opacity: 0.9;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cgb__slide-content {
      gap: 0.4rem;
    }

    #shopify-section-{{ section.id }} .cgb__slide-button {
      padding: 0.55rem 1.25rem;
      font-size: 0.9rem;
    }
  }
{% endstylesheet %}

{% javascript %}
{% endjavascript %}