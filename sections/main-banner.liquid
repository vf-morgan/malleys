{% schema %}
  {
    "presets": [
      {
        "name" : "Main Banner"
      }
    ],
    "name": "Main Banner",
    "settings": [],
     "max_blocks": 4,
      "blocks": [
     {
       "name": "Slide",
       "type": "slide",
       "settings": [
         {
           "type": "image_picker",
           "id": "slide_image",
           "label": "Image"
         },
         {
           "type":"header",
           "content":"Show pricing use span tag"
         },         
         {
          "type": "textarea",
          "id": "slide_main_heading",
          "label": "Main Heading",
          "default": "<span>$5</span> OFF",
           "info": "<span>$5</span> use this for show price"
         },      
         {
           "type": "text",
           "id": "slide_heading",
             "label": "Heading",
           "default":"Cranberry Rascals"
         },
         {
           "type": "text",
           "id": "slide_sub_heading",
           "label": "Sub Heading",
           "default":"For the Month of November"
         },
         {
           "type": "richtext",
           "id": "slide_rich_text",
           "label": "Description",
           "default":"<p>Malley’s Cranberry Rascals, featuring dak chocolate covering salted almonds and tart cranberries in our special-recipe caramel, Sale ends November 30th, 2023.</p>"
         },
         {
           "type": "text",
           "id": "slide_button",
           "label": "Button Text",
           "default":"Order Now"
         },
         {
           "type": "url",
           "id": "slide_link",
           "label": "Link"
         }
       ]
     }
    ]
  }
{% endschema %}

