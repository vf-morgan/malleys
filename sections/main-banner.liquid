{% comment %} <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/swiper@11/swiper-bundle.min.css" /> {% endcomment %}
<div class="banner__wrapper">
  <div class="container">
    <div class="swiper main__banner-slider">
      <div class="swiper-wrapper">
        {% for block in section.blocks %}
          {% case block.type %}
            {% when 'slide' %}
              <div class="swiper-slide">
                <div class="banner__slide-item--row">
                  <div class="banner__item-image">
                    {%- liquid                                
                          assign sizes = '120vw'
                          assign widths = '280 , 350, 450, 550, 660, 900, 1320'
                    -%}
                    {% if block.settings.slide_image != blank  %}
                      {{
                        block.settings.slide_image
                        | image_url: width: 1320
                        | image_tag: loading: 'lazy', sizes: sizes, widths: widths
                      }}    
                       {% else %}
                        {{ "image" | placeholder_svg_tag:"placeholder-svg-tag" }}
                       {% endif %}
                    <!-- <img src="https://cdn.shopify.com/s/files/1/0627/8476/6124/files/banner_img.png?v=1700201877" alt=""> -->
                  </div>
                  <div class="banner__item-text">
                    {% if block.settings.slide_main_heading != blank %}
                      <h2>{{ block.settings.slide_main_heading }}</h2>
                    {% endif %}
                    {% if block.settings.slide_heading != blank %}
                      <h3>{{ block.settings.slide_heading }}</h3>
                    {% endif %}
                    {% if block.settings.slide_sub_heading != blank %}
                      <h4>{{ block.settings.slide_sub_heading }}</h4>
                    {% endif %}
                    {% if block.settings.slide_rich_text != blank %}
                      {{ block.settings.slide_rich_text }}
                    {% endif %}
                    {% if block.settings.slide_button != blank %}
                      <a href="{{ block.settings.slide_link }}" class="btn">{{ block.settings.slide_button }}</a>
                    {% endif %}
                  </div>
                </div>
              </div>
            {% endcase %}
        {% endfor %}
