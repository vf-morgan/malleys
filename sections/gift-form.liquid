  <style>
    .globo-form-control label{
      width: 100%;
      display: inline-block;
      color: #451405 !important;
      font-family: Poppins;
      font-size: 16px;
      font-style: normal;
      font-weight: 500;
      line-height: 131.523%;
      letter-spacing: .48px;
      margin-bottom: 10px;
    }
    .globo-form-control label span{
      color: #451405 !important;
    }
    .globo-form-control .checkbox-wrapper .checkbox-input {
        display: none !important;
    }
    .globo-form-control .checkbox-wrapper label.globo-label span.label-content {
      color: #4514054d !important;
      text-align: left !important;
  }
    .globo-form-control .checkbox-wrapper label.globo-label span.label-content a {
          display: inline-block;
    color: #4514054d !important;
    text-decoration-line: underline;
  }
    .globo-form-app button.submit, .globo-form-app button.submit:focus{
          color: #fff;
          font-family: Poppins;
          font-size: 18px !important;
          font-style: normal !important;
          font-weight: 600 !important;
          line-height: 126.523% !important;
          letter-spacing: .54px !important;
          padding: 24px 42px !important;
          border: none !important;
          background: #451405 !important;
    }
    .globo-form-app button.submit:hover{
      background: #280700 !important;
    transition: color .15s ease-in-out,background-color .15s ease-in-out,border-color .15s ease-in-out,box-shadow .15s ease-in-out;
    }
  </style>
