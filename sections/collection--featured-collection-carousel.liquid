{{ 'section-featured-collection.min.css' | asset_url | stylesheet_tag }}

<section class="homepage-sections-wrapper cgc__wrapper">

  <div class="container" data-wetheme-section-type="collection--featured-collection-carousel" data-wetheme-section-id="{{ section.id }}">
    <div class="row">
      <div class="page-width col-md-12">

      {% if section.settings.title != blank or section.settings.subheading != blank %}
        <div class="title-bar custom-font">
          {% if section.settings.subheading != blank %}
            <h3 class="type-subheading type-subheading--1 wow{% if section.settings.title != blank %} typography--padding-bottom{% endif %}">{{ section.settings.subheading | escape }}</h3>
          {% endif %}
          {% if section.settings.title != blank %}
            <h2 class="wow">{{ section.settings.title | escape }}</h2>
          {% endif %}
        </div>
      {% endif %}

      {% assign collection = collections[section.settings.collection] %}
      {% assign product_limit = section.settings.products_to_show %}
      {% assign hide-add-to-cart = section.settings.hide_add_to_cart %}

      <div class="cgc__carousel-wrap">
        {% if section.settings.enable_arrows %}
          <button type="button" class="cgc__arrow cgc__arrow--prev" data-cgc-prev aria-label="{{ 'general.slider.previous_slide' | t | default: 'Previous' }}">
            <span aria-hidden="true">&#8249;</span>
          </button>
          <button type="button" class="cgc__arrow cgc__arrow--next" data-cgc-next aria-label="{{ 'general.slider.next_slide' | t | default: 'Next' }}">
            <span aria-hidden="true">&#8250;</span>
          </button>
        {% endif %}

        <div class="cgc__carousel" data-cgc-carousel style="--cgc-cols-desktop: {{ section.settings.grid }};" tabindex="0">
          <div class="cgc__track homepage-featured-products">

            {% for product in collection.products limit: product_limit %}
              <div class="cgc__slide grid__item">
                {%-
                  render 'product-grid--indiv-product',
                  liquidObject: product, section: section, hideBtns: hide-add-to-cart
                -%}
              </div>

            {% else %}

              {% for i in (1..product_limit) %}
                <div class="cgc__slide grid__item">
                  <article class="indiv-product">
                    <a href="{{ product.url | within: collection }}" title="{{product.title}}">
                      {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                      {{ 'product-' | append: current | placeholder_svg_tag: 'icon--placeholder' }}
                    </a>
                    <div class="hp-title">
                      <a href="{{ product.url | within: collection }}">
                        <span class="indiv-product-title-text">{{ 'general.onboarding.product_title' | t }}</span>
                        <span class="money money-styling">
                          {{ 1999 | money }}
                        </span>
                      </a>
                    </div>
                  </article>
                </div>
              {% endfor %}
            {% endfor %}

          </div>
        </div>
      </div>

      {% if section.settings.show_view_all %}
        <div class="text-center wow">
          <a href="{{ collection.url }}" class="btn btn--view-all">
            {{ 'collections.general.view_all' | t }}
          </a>
        </div>
      {% endif %}
    </div>
    </div>
  </div>
</section>

<script>
  (function () {
    function slideAmount(carousel) {
      var slide = carousel.querySelector('.cgc__slide');
      if (!slide) return carousel.clientWidth;
      var style = window.getComputedStyle(carousel.querySelector('.cgc__track'));
      var gap = parseFloat(style.columnGap || style.gap || 0);
      return slide.getBoundingClientRect().width + gap;
    }

    function updateArrows(carousel, prevBtn, nextBtn) {
      if (!prevBtn || !nextBtn) return;
      var maxScroll = carousel.scrollWidth - carousel.clientWidth - 2;
      prevBtn.disabled = carousel.scrollLeft <= 0;
      nextBtn.disabled = carousel.scrollLeft >= maxScroll;
    }

    function initCarousel(root) {
      if (!root || root.dataset.cgcInit) return;
      root.dataset.cgcInit = 'true';

      var carousel = root.querySelector('[data-cgc-carousel]');
      var prevBtn = root.querySelector('[data-cgc-prev]');
      var nextBtn = root.querySelector('[data-cgc-next]');
      if (!carousel) return;

      prevBtn && prevBtn.addEventListener('click', function () {
        carousel.scrollBy({ left: -slideAmount(carousel), behavior: 'smooth' });
      });

      nextBtn && nextBtn.addEventListener('click', function () {
        carousel.scrollBy({ left: slideAmount(carousel), behavior: 'smooth' });
      });

      carousel.addEventListener('scroll', function () {
        updateArrows(carousel, prevBtn, nextBtn);
      }, { passive: true });

      window.addEventListener('resize', function () {
        updateArrows(carousel, prevBtn, nextBtn);
      });

      updateArrows(carousel, prevBtn, nextBtn);

      {% if section.settings.autoplay %}
      var autoplayTimer = setInterval(function () {
        var maxScroll = carousel.scrollWidth - carousel.clientWidth - 2;
        if (carousel.scrollLeft >= maxScroll) {
          carousel.scrollTo({ left: 0, behavior: 'smooth' });
        } else {
          carousel.scrollBy({ left: slideAmount(carousel), behavior: 'smooth' });
        }
      }, {{ section.settings.autoplay_speed | times: 1000 }});

      carousel.addEventListener('mouseenter', function () { clearInterval(autoplayTimer); });
      {% endif %}
    }

    function initAll() {
      document.querySelectorAll('.cgc__wrapper').forEach(initCarousel);
    }

    document.addEventListener('DOMContentLoaded', initAll);
    initAll();

    document.addEventListener('shopify:section:load', function (event) {
      var root = event.target.querySelector('.cgc__wrapper');
      if (root) initCarousel(root);
    });
  })();
</script>

{% stylesheet %}
  #shopify-section-{{ section.id }} .cgc__carousel-wrap {
    position: relative;
  }

  #shopify-section-{{ section.id }} .cgc__carousel {
    overflow-x: auto;
    overflow-y: hidden;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
    scrollbar-width: none;
    padding-bottom: 0.5rem;
  }

  #shopify-section-{{ section.id }} .cgc__carousel::-webkit-scrollbar {
    display: none;
  }

  #shopify-section-{{ section.id }} .cgc__track {
    display: flex;
    gap: 12px;
  }

  #shopify-section-{{ section.id }} .cgc__slide {
    flex: 0 0 auto;
    scroll-snap-align: start;
    width: 58.8%;
    display: flex;
  }

  #shopify-section-{{ section.id }} .cgc__slide > * {
    width: 100%;
  }

  #shopify-section-{{ section.id }} .indiv-product-title-text {
    display: block;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #shopify-section-{{ section.id }} .cgc__arrow {
    position: absolute;
    top: 40%;
    transform: translateY(-50%);
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border-radius: 50%;
    border: 1px solid #4E3120;
    background: #FFFFFF;
    color: #4E3120;
    font-size: 1.5rem;
    line-height: 1;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .cgc__arrow:hover {
    background: #4E3120;
    color: #FFFFFF;
  }

  #shopify-section-{{ section.id }} .cgc__arrow:disabled {
    opacity: 0.35;
    cursor: default;
  }

  #shopify-section-{{ section.id }} .cgc__arrow--prev {
    left: -0.5rem;
  }

  #shopify-section-{{ section.id }} .cgc__arrow--next {
    right: -0.5rem;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .cgc__track {
      gap: 20px;
    }

    #shopify-section-{{ section.id }} .cgc__slide {
      width: 44.4%;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .cgc__track {
      gap: 24px;
    }

    #shopify-section-{{ section.id }} .cgc__slide {
      width: calc((100% - (24px * (var(--cgc-cols-desktop) - 1))) / var(--cgc-cols-desktop));
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cgc__arrow {
      display: none;
    }
  }
{% endstylesheet %}

