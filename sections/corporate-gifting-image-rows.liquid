<section class="cgir__wrapper section-{{ section.id }}-padding">
  <div class="container">
    <div class="row">
      <div class="col-12">
        <div class="cgir__rows">
          {%- for block in section.blocks -%}
            {%- if block.type == 'row' -%}
              <div class="cgir__row" {{ block.shopify_attributes }}>
                <div class="cgir__image">
                  {%- if block.settings.image != blank -%}
                    {{
                      block.settings.image
                      | image_url: width: 1200
                      | image_tag: loading: 'lazy', widths: '400, 600, 900, 1200', alt: block.settings.image.alt
                    }}
                  {%- else -%}
                    {{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <div class="cgir__content">
                  {%- if block.settings.heading != blank -%}
                    <h2 class="cgir__heading custom-font">{{ block.settings.heading }}</h2>
                  {%- endif -%}
                  {%- if block.settings.content != blank -%}
                    <div class="cgir__text rte">{{ block.settings.content }}</div>
                  {%- endif -%}
                  {%- if block.settings.button_label != blank -%}
                    <a href="{{ block.settings.button_link | default: '#' }}" class="cgir__button">
                      {{ block.settings.button_label }}
                    </a>
                  {%- endif -%}
                  {%- if block.settings.contact_heading != blank -%}
                    <p class="cgir__contact-heading">{{ block.settings.contact_heading }}</p>
                  {%- endif -%}
                  {%- if block.settings.email != blank or block.settings.phone != blank -%}
                    <p class="cgir__contact-details">
                      {%- if block.settings.email != blank -%}
                        Email <a href="mailto:{{ block.settings.email }}">{{ block.settings.email }}</a>
                      {%- endif -%}
                      {%- if block.settings.email != blank and block.settings.phone != blank -%}  {%- endif -%}
                      {%- if block.settings.phone != blank -%}
                        ‎ or call us at <a href="tel:{{ block.settings.phone | remove: '-' | remove: ' ' | remove: '(' | remove: ')' }}" class="cgir__phone-link">{{ block.settings.phone }}</a>
                      {%- endif -%}
                    </p>
                  {%- endif -%}
                </div>
              </div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% style %}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .cgir__rows {
    display: flex;
    flex-direction: column;
    gap: 4.5rem;
  }

  #shopify-section-{{ section.id }} .cgir__row {
    display: flex;
    align-items: center;
    gap: 4rem;
  }

  #shopify-section-{{ section.id }} .cgir__row:nth-child(even) {
    flex-direction: row-reverse;
  }

  #shopify-section-{{ section.id }} .cgir__image,
  #shopify-section-{{ section.id }} .cgir__content {
    flex: 1 1 50%;
    min-width: 0;
  }

  #shopify-section-{{ section.id }} .cgir__image img,
  #shopify-section-{{ section.id }} .cgir__image svg {
    width: 100%;
    height: auto;
    display: block;
    border-radius: 8px;
    object-fit: cover;
    aspect-ratio: 4 / 3;
  }

  #shopify-section-{{ section.id }} .cgir__heading {
    margin: 0 0 1.25rem;
  }

  #shopify-section-{{ section.id }} .cgir__text ul {
    margin: 0;
    padding-left: 1.25rem;
  }

  #shopify-section-{{ section.id }} .cgir__text li {
    margin-bottom: 0.75rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .cgir__text li:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .cgir__text p {
    margin: 0 0 1.25rem;
    line-height: 1.6;
  }

  #shopify-section-{{ section.id }} .cgir__button {
    display: inline-block;
    margin: 1.75rem 0 1.25rem;
    background-color: var(--color-brand-pink, #F0A8C0);
    color: #4E3120;
    font-weight: 700;
    text-transform: uppercase;
    text-decoration: none;
    padding: 1rem 2rem;
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .cgir__contact-heading {
    font-weight: 700;
    margin: 0 0 0.4rem;
  }

  #shopify-section-{{ section.id }} .cgir__contact-details {
    margin: 0;
  }

  #shopify-section-{{ section.id }} .cgir__phone-link {
    color: inherit;
    text-decoration: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .cgir__rows {
      gap: 3rem;
    }

    #shopify-section-{{ section.id }} .cgir__row,
    #shopify-section-{{ section.id }} .cgir__row:nth-child(even) {
      flex-direction: column;
      align-items: stretch;
      gap: 1.75rem;
    }
  }
{% endstyle %}

