<script defer>
  window.addEventListener('load', ()=>{
    // Email Script
    function gtag_report_email_conversion(url) {
      var callback = function () {
      if (typeof(url) != 'undefined') {
      window.location = url;
      }
      };
      gtag('event', 'conversion', {
      'send_to': 'AW-993985712/uwqMCIu8pekYELCJ_NkD',
      'event_callback': callback
      });
      return false;
    }
    document.querySelectorAll('a[href^="mailto:"]').forEach(ele=>{
      ele.addEventListener('click', (e)=>{
        e.preventDefault();
        gtag_report_email_conversion(e.target.href)
      })
    })

    // Phone Number Script
    function gtag_report_phone_conversion(url) {
      var callback = function () {
      if (typeof(url) != 'undefined') {
      window.location = url;
      }
      };
      gtag('event', 'conversion', {
      'send_to': 'AW-993985712/KUIqCIi8pekYELCJ_NkD',
      'event_callback': callback
      });
      return false;
      }
    document.querySelectorAll('a[href^="tel:"]').forEach(ele=>{
      ele.addEventListener('click', (e)=>{
        e.preventDefault();
        gtag_report_phone_conversion(e.target.href)
      })
    })
  })
</script>

