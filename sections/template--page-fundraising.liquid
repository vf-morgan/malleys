<article id="{{ template.name }}-{{page.handle}}" class="page hentry container">
  <header>
    <div class="title-bar custom-font">
      <h1 class="main-heading">{{ page.title }}</h1>
    </div>
  </header>
  <section class="entry-content">
    {{ page.content }}
    {% if section.settings.show_contact_form %}
      {% form 'contact' %}
        <p class="success-msg form-success{% unless form.posted_successfully? %} hide{% endunless %}">
          {{ 'contact.form.post_success' | t }}
        </p>
        {% if form.posted_successfully? %}
          <script>
            window.location.href = '/pages/thankyou?form=fundraising'
          </script>
        {% endif %}
        {% render 'form-errors-custom', form: form %}

        <div id="contact-form">
          <div class="row">
            <div class="col-md-6 col-12">
              <div class="form-group">
                <label for="first-name">First Name</label>
                <input
                  type="text"
                  name="contact[first-name]"
                  id="first-name"
                  class="form-control"
                >
              </div>
            </div>
            <div class="col-md-6 col-12">
              <div class="form-group">
                <label for="last-name">Last Name</label>
                <input
                  type="text"
                  name="contact[last-name]"
                  id="last-name"
                  class="form-control"
                >
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-6 col-12">
              <div class="form-group">
                <label for="company-or-organization">Company/Organization</label>
                <input
                  type="text"
                  name="contact[company-or-organization]"
                  id="company-or-organization"
                  class="form-control"
                  value="{% if customer %}{{ customer.name }}{% endif %}"
                >
              </div>
            </div>

            <div class="col-md-6 col-12">
              <div class="form-group">
                <label for="email">{{ 'contact.form.email' | t }}</label>
                <input
                  type="email"
                  name="contact[email]"
                  id="email"
                  class="form-control"
                  value="{% if customer %}{{ customer.email }}{% endif %}"
                  spellcheck="false"
                  autocomplete="off"
                  autocapitalize="off"
                >
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-12">
              <div class="form-group">
                <label for="phone">{{ 'contact.form.phone' | t }}</label>
                <input
                  type="tel"
                  name="contact[phone]"
                  class="form-control"
                  id="phone"
                  value="{% if customer %}{{ customer.phone }}{% endif %}"
                  pattern="[0-9\-]*"
                >
              </div>
            </div>
          </div>
          <div class="row">
            <div class="col-md-12">
              <div class="form-group">
                <label for="fundraising-program">Please specify which fundraising program you’re interested in?</label>
                <select id="fundraising-program" class="form-control" name="contact[fundraising-program]" aria-label="Please specify which fundraising program you’re interested in?">
                  <option selected disabled>Please Choose Option</option>
                  <option value="Chocolate Bars">Chocolate Bars</option>
                  <option value="Easter">Easter</option>
                  <option value="Both">Both</option>
                </select>
              </div>
            </div>
          </div>

          <div class="row">
            <div class="col-md-12">
              <div class="form-group">
                <label for="message">{{ 'contact.form.message' | t }}</label>
                <textarea id="message" rows="10" class="form-control" name="contact[body]"></textarea>
              </div>
            </div>
          </div>

          {{ 'shopify.online_store.spam_detection.disclaimer_html' | t }}

          <div class="row">
            <div class="col-md-12 btn-contact--wrapper">
              <div class="form-group" id="newsletter-wrapper-{{ page.title | handle }}">
                <input type="submit" class="btn" value="{{ 'contact.form.send' | t }}">
              </div>
              <div class="lds-dual-ring newsletter-spinner hide"></div>
            </div>
          </div>
        </div>
      {% endform %}
    {% endif %}
  </section>
</article>
