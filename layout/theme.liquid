<script>
 document.querySelectorAll('li.dropdown > div.mega-menu--dropdown-wrapper > a').forEach(function(el) {
  el.addEventListener('keydown', function(e) {
    if (e.key !== 'Enter') return;

    e.stopPropagation();
    e.preventDefault();

    const wrapper = el.closest('.mega-menu--dropdown-wrapper');
    const isOpen = wrapper.classList.contains('open');

    // Close all other open menus
    document.querySelectorAll('.mega-menu--dropdown-wrapper.open').forEach(function(openWrapper) {
      if (openWrapper !== wrapper) {
        openWrapper.classList.remove('open');
        const otherAnchor = openWrapper.querySelector(':scope > a');
        if (otherAnchor) otherAnchor.setAttribute('aria-expanded', 'false');
      }
    });

    // Toggle current menu
    if (isOpen) {
      wrapper.classList.remove('open');
      el.setAttribute('aria-expanded', 'false');
    } else {
      wrapper.classList.add('open');
      el.setAttribute('aria-expanded', 'true');
    }
  });

  // Prevent click from navigating when submenu exists
  el.addEventListener('click', function(e) {
    const wrapper = el.closest('.mega-menu--dropdown-wrapper');
    const hasSubmenu = wrapper.querySelector('.dropdown-menu');
    if (hasSubmenu) {
      e.preventDefault();
      e.stopPropagation();
    }
  });
});
</script>
<script>
  //Functionality that focuses on the module close button once the popup becomes visible
function MiniBasketFocus(){
  document.querySelector(".jdgm-review-widget-modal .jdgm-write-review-modal__close-btn").focus();  //Focus on close button
}

var MaxTime = 30000; var totalTime = 0;
function IntervalSearch() {
  if (document.querySelectorAll('.jdgm-review-widget-modal').length > 0 ) {
    var targetNode = document.querySelector('.jdgm-review-widget-modal'); //Find modal
      var observer = new MutationObserver(function(){
          if(targetNode.style.display != 'none'){
              setTimeout(MiniBasketFocus, 500); //When modal is visible, change focus to button
          }
      });
      observer.observe(targetNode, { attributes: true, childList: true }); 
      document.querySelectorAll('a.jdgm-star[role="button"]').forEach(function(star) {
        star.addEventListener('keydown', function(e) {
          if (e.key === 'Enter') {
            e.preventDefault();
            star.click();
          }
        });
      });


  } else if(totalTime < MaxTime) {
    setTimeout(IntervalSearch, 20);
	  totalTime += 20;
  }
}
IntervalSearch();

setTimeout(IntervalSearch, 20);
</script>

<script>
//Adds open in new window to any link that opens in a new window
function AddHiddenTitleToNewWindowLink() {
    var elements = document.querySelectorAll("[target='_blank']");
    for (var i = 0; i < elements.length; i++) {
        var title = document.createElement("span");
        var textnode = document.createTextNode(" Open in new window");
        title.classList.add("sr-only");
        title.appendChild(textnode);
        elements[i].appendChild(title);
    }
}
AddHiddenTitleToNewWindowLink();
</script>


{% render 'navistone-page-visit-event-snippet' %}


<script>
(function(){
  const calendarId = "9e5cc3ce-7576-4974-a256-9925ee015054";

  function getMinDate(){
    const d = new Date();
    d.setDate(d.getDate() + 14);
    return d.toISOString().split("T")[0];
  }

  function applyMinDate(){
    const calendar =
      document.getElementById(calendarId) ||
      document.querySelector(`[data-calendar-id="${calendarId}"]`);

    if (!calendar) return;

    const minDate = getMinDate();
    const inputs = calendar.matches("input")
      ? [calendar]
      : calendar.querySelectorAll('input[type="date"], input[name*="date"], input');

    inputs.forEach(function(input){
      input.setAttribute("min", minDate);

      input.addEventListener("change", function(){
        if (input.value && input.value < minDate) {
          input.value = "";
          alert("Please select a date at least 2 weeks from today.");
        }
      });
    });
  }

  document.addEventListener("DOMContentLoaded", applyMinDate);
  setTimeout(applyMinDate, 1000);
  setTimeout(applyMinDate, 3000);
})();
</script>

