      "name": "Custom Liquid",
      "settings": {
        "custom_liquid": "<link href=\"https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,700;1,700&display=swap\" rel=\"stylesheet\">\n\n<style>\n  .cgft-section {\n    width: 100%;\n    max-width: none;\n    margin: 0;\n    padding: 3rem 1.5rem;\n    box-sizing: border-box;\n    text-align: center;\n    overflow: hidden;\n  }\n\n  .cgft-section h2 {\n    margin: 0 0 2rem;\n  }\n\n  .cgft-grid {\n    display: grid;\n    grid-template-columns: repeat(4, minmax(0, 1fr));\n    gap: 1.5rem;\n    width: 100%;\n    box-sizing: border-box;\n  }\n\n  .cgft-tile {\n    background-color: #F6A9C2;\n    padding: 1.5rem;\n    display: flex;\n    flex-direction: column;\n    justify-content: center;\n    align-items: flex-start;\n    text-align: left;\n    aspect-ratio: 1 / 1;\n    min-width: 0;\n    box-sizing: border-box;\n  }\n\n  .cgft-quote,\n  .cgft-stat {\n    font-family: 'omnes-cond', var(--font-heading-family, sans-serif);\n    font-weight: 600;\n    font-style: italic;\n    font-size: clamp(1rem, 1.35vw, 1.5rem);\n    line-height: 1.2;\n    color: #4E3120;\n    margin: 0;\n  }\n\n  .cgft-attribution {\n    font-family: 'omnes-cond', var(--font-heading-family, sans-serif);\n    font-weight: 600;\n    font-style: italic;\n    font-size: 1rem;\n    color: #4E3120;\n    margin: 0;\n  }\n\n  /* TABLET / SMALL LAPTOP: 2x2 grid */\n  @media screen and (min-width: 750px) and (max-width: 989px) {\n    .cgft-grid {\n      grid-template-columns: repeat(2, minmax(0, 1fr));\n    }\n    .cgft-quote,\n    .cgft-stat {\n      font-size: clamp(1.1rem, 2.2vw, 1.5rem);\n    }\n  }\n\n  /* MOBILE: swipeable row */\n  @media screen and (max-width: 749px) {\n    .cgft-section {\n      padding: 3rem 1rem;\n    }\n\n    .cgft-grid {\n      display: flex;\n      width: 100%;\n      overflow-x: auto;\n      scroll-snap-type: x mandatory;\n      -webkit-overflow-scrolling: touch;\n      gap: 1rem;\n      padding-bottom: 0.5rem;\n    }\n\n    .cgft-tile {\n      flex: 0 0 85%;\n      scroll-snap-align: center;\n    }\n\n    .cgft-quote,\n    .cgft-stat {\n      font-size: 1.25rem;\n    }\n  }\n</style>\n\n<div class=\"cgft-section\">\n\n  <h2>Fundraising Testimonials</h2>\n\n  <div class=\"cgft-grid\">\n\n    <div class=\"cgft-tile\">\n      <p class=\"cgft-quote\">\n        &ldquo;The percentage our group got back was great, and the online platform is user friendly.&rdquo;\n      </p>\n    </div>\n\n    <div class=\"cgft-tile\">\n      <p class=\"cgft-quote\">\n        &ldquo;It was super easy! As the organizer at my school, I did not have to do much to get the chocolates to sell!&rdquo;\n      </p>\n    </div>\n\n    <div class=\"cgft-tile\">\n      <p class=\"cgft-quote\">\n        &ldquo;Having individual student links was awesome! And I loved that I could check our progress!&rdquo;\n      </p>\n    </div>\n\n    <div class=\"cgft-tile\">\n      <p class=\"cgft-quote\">\n        &ldquo;Everything was easy to manage and communication was great!&rdquo;\n      </p>\n    </div>\n\n  </div>\n\n</div>"
      }
