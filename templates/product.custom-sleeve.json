dEventListener('input', validate);\n    qtyInput.addEventListener('change', validate);\n    qtyInput.addEventListener('blur', validate);\n\n    if (form) {\n      // Fallback: block native form submit\n      form.addEventListener('submit', function (e) {\n        if (!validate()) {\n          e.preventDefault();\n          e.stopImmediatePropagation();\n        }\n      }, true);\n\n      // Block AJAX add-to-cart button clicks before the theme's own handler runs\n      form.querySelectorAll('[name=\"add\"], button[type=\"submit\"], input[type=\"submit\"]').forEach(function (btn) {\n        btn.addEventListener('click', function (e) {\n          if (!validate()) {\n            e.preventDefault();\n            e.stopImmediatePropagation();\n            e.stopPropagation();\n          }\n        }, true);\n      });\n    }\n  }\n\n  document.addEventListener('DOMContentLoaded', initQuantityMinimum);\n  document.addEventListener('shopify:section:load', initQuantityMinimum);\n})();\n</script>"
